{
  "servers": [
    "@modelcontextprotocol/server-filesystem",
    "@modelcontextprotocol/server-github"
  ],
  "groups": [
    {
      "name": "file_ops",
      "description": "File operations tool group (read/write/edit/search, from the official filesystem server)",
      "match": [
        "read_file",
        "write_file",
        "edit_file",
        "list_directory",
        "directory_tree",
        "search_files",
        "get_file_info",
        "list_allowed_directories",
        "create_directory",
        "move_file"
      ]
    },
    {
      "name": "git_ops",
      "description": "Git and code repository tool group",
      "match": [
        "git_*",
        "create_issue",
        "create_pull_request",
        "get_issue",
        "search_repos",
        "search_code",
        "list_issues",
        "merge_pull_request"
      ]
    },
    {
      "name": "github_ops",
      "description": "GitHub platform tool group",
      "match": [
        "github_*",
        "gh_*",
        "get_*",
        "list_*"
      ]
    },
    {
      "name": "default",
      "description": "Default group for ungrouped tools",
      "match": []
    }
  ],
  "default_group": "default"
}