{
  "schema_version": 1,
  "description": "Default LLM provider catalog bundled with ProviderManager. Each entry describes one provider API: the base URL, the request paths of the OpenAI/Anthropic wire formats it speaks, and how to authenticate. A local providers file (see ProviderManager and docs/llm-provider-manager.md) can add new providers or override any field below by provider id. API keys are NEVER stored here - they come from the environment variable named by \"api_key_env\" (same name also accepted as a -D system property), from the \"api_keys\" map of the local providers file, or from ProviderManager.setApiKey().",
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "api_format": "openai",
      "base_url": "https://api.openai.com/v1",
      "models_path": "/models",
      "chat_completions_path": "/chat/completions",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-4o-mini",
      "website": "https://platform.openai.com/docs/api-reference",
      "enabled": true,
      "description": "Official OpenAI API (GPT, o-series, embeddings, ...)"
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "api_format": "anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "models_path": "/models",
      "chat_completions_path": "/messages",
      "api_key_env": "ANTHROPIC_API_KEY",
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "default_model": "claude-sonnet-4-20250514",
      "website": "https://platform.claude.com/docs/en/api",
      "enabled": true,
      "description": "Official Anthropic API (Claude). Anthropic wire format: x-api-key header plus anthropic-version header."
    },
    {
