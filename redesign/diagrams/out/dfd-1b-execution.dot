digraph "dfd_1b" {
  rankdir="LR";
  nodesep="0.35";
  ranksep="0.85";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "d1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D1</B> AgentMailbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">ready / deferred</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "p7" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P7</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">TaskRunner</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">出队 → 过 LifecycleGate → 收尾</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p10" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P10</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">SystemPrompt</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">人设 + 时钟 + 昨日总结</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p8" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P8</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ToolLoop</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">LLM ↔ 工具循环，受 ToolLoopPolicy 限</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_llm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E2</B> LLM 服务</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">OpenAI 兼容端点</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p9" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P9</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">Toolbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">按工具名分派到某个 Tool</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_pc" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E5</B> 个人电脑</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">podman / 本地 / SSH</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d6" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D6</B> 笔记 / 待办 / 技能 / 提醒</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">角色私有资料</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d7" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D7</B> Mailbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">公司邮箱</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d8" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D8</B> Team / Agent</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">同事 · 花名册</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "e_client" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E3</B> 客户 / 用户</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">ask_client</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p11" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P11</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ConversationMemory</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">prepare / commit / closeDay</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d3" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D3</B> ConversationMemory</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">当日消息 + 压缩摘要</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "p12" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P12</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">Transcript</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">推理 / 工具 / 答案 / 群聊</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d4" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D4</B> Transcript</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">Entry(seq, …)</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d1" -> "p7" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" Task（ready 队列，先到先做） "];
  "p7" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 状态 / 当前任务 / 历史 "];
  "d6" -> "p10" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 昨日总结 "];
  "p10" -> "p8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" system prompt "];
  "p7" -> "p8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 任务描述 + 本角色工具清单 "];
  "d3" -> "p8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 历史消息 "];
  "p8" -> "e_llm" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 消息 + 工具声明 "];
  "e_llm" -> "p8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 文本 / tool_calls / tokens "];
  "p8" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" invoke(name, Payload) "];
  "p9" -> "p8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" ToolResult(ok | error) "];
  "p9" -> "e_pc" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 命令 / 写文件 "];
  "e_pc" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" stdout / 文件内容 "];
  "p9" -> "d6" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 记笔记 · 建待办 · 定提醒 "];
  "d6" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 读笔记 / 技能正文 "];
  "p9" -> "d7" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 发信 "];
  "d7" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 收件箱 / 未读 "];
  "p9" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" talk / 招聘 / 查花名册 "];
  "d8" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 同事回复 / 代理任务结果 "];
  "p9" -> "e_client" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" ask_client 提问 "];
  "e_client" -> "p9" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 客户回复 "];
  "d3" -> "p11" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 已有对话 "];
  "p8" -> "p11" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 本轮问答 "];
  "p11" -> "d3" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" commit / closeDay "];
  "p7" -> "p12" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 推理 / 答案 / 失败原因 "];
  "p9" -> "p12" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 工具轨迹 "];
  "p12" -> "d4" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" Entry(seq, kind, …) "];
  "d4" -> "e_client" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" /api/feed?since=seq 增量拉取 "];
  "p7" -> "d1" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 出队 "];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">矩形 = 外部实体 E</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">圆角 = 处理 P</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">横线夹字 = 数据存储 D</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">实线 = 主数据流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">虚线 = 查询 / 次要流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P8 的循环最多跑</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">ToolLoopPolicy.maxRounds 轮，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">超过就带失败结论收尾。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">工具返回 error 不抛异常，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">而是当成一条 tool 消息</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">喂回模型 —— 让模型自己纠错。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P9 是唯一的“外向”出口：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">电脑 / 邮箱 / 同事 / 客户</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">四类副作用都从这里出。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
