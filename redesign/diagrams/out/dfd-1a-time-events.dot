digraph "dfd_1a" {
  rankdir="LR";
  nodesep="0.35";
  ranksep="0.9";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "e_tick" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E1</B> 时钟线程</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">ClockDriver 自己的工作线程</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P1</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ClockPolicy</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">纯决策，无 I/O</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P2</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ClockDriver</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">每步：传感器→策略→推进→取事件</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p3" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P3</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ShiftDirector</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">上下班边界动作</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D2</B> ScheduleTable</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">定时提醒项</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "e_client" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E3</B> 客户 / 用户</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">Web GUI · 控制台</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_smtp" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E6</B> SMTP 服务</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">新邮件</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d7" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D7</B> Mailbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">收件箱</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "p4" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P4</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">EventRouter</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">解收件人：广播→全员 / 定向→单人</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p5" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P5</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">DeliveryPolicy</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">纯决策：DELIVER / HOLD / DROP</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p5s" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P5.1</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">SaliencePolicy</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">兴趣得分</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p6" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P6</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">TaskFactory</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">AgentEvent → Task</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D1</B> AgentMailbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">ready / deferred</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d8" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D8</B> Team / Agent</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">花名册 · 状态 · 历史</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "e_tick" -> "p2" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 每步 "];
  "p2" -> "p1" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" ClockSignals "];
  "p1" -> "p2" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" ClockAction "];
  "p2" -> "d2" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" nextFireTick "];
  "d2" -> "p2" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" due(now) "];
  "p2" -> "p3" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" onTick(Tick) "];
  "p3" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 开机 / 提升暂存 / 收尾 / 强制下班 "];
  "d8" -> "p1" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" anyBusy / allIdle / allOffDuty "];
  "e_client" -> "p4" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 提问 / 回复 / 暂停·恢复 "];
  "e_smtp" -> "d7" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 新邮件 "];
  "d7" -> "p4" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" NEW_MAIL "];
  "d2" -> "p4" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" AgentEvent（到期提醒） "];
  "d8" -> "p4" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 收件人名单 specs() "];
  "p4" -> "p5" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" DeliveryContext（逐收件人） "];
  "p5s" -> "p5" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 得分 / 阈值 "];
  "p5" -> "p6" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" DELIVER "];
  "p5" -> "d1" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" HOLD → deferred=true "];
  "p6" -> "d1" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" Task（含 urgency / context） "];
  "p6" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" assignee "];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">矩形 = 外部实体 E</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">圆角 = 处理 P</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">横线夹字 = 数据存储 D</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">实线 = 主数据流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">虚线 = 查询 / 次要流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P1 / P5 是纯函数：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">同样输入必得同样输出，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">方便单测，也不碰 I/O。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">HOLD 不是丢弃：任务进</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">deferred 队列，等 P3 在</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">上班 / 状态变化时提升。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P3 是唯一会改 Agent 状态</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">的班次推手。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
