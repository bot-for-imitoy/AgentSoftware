digraph "dfd_1c" {
  rankdir="LR";
  nodesep="0.35";
  ranksep="0.9";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "e_conf" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E5</B> 角色与配置</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">role_templates.json · providers.json</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p0" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P0</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">CompanyBuilder + ToolkitCatalog</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">唯一知道全部具体类的装配点</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p0b" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P0.1</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">Company</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">组合根：start / stop / pause</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p3" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P3</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ShiftDirector</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">onShiftEnd 边界</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p11" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P11</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">ConversationMemory</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">closeDay</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d6" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D6</B> NoteBook</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">当日总结</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d3" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D3</B> ConversationMemory</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">当日对话</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "p13" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P13</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">Company.save / restore</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">整公司一份 JSON</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d5" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D5</B> state.json</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">CompanySnapshot</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "e_disk" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E4</B> 宿主磁盘</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">角色目录 / workdir / state.json</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "p14" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>P14</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">Staffing / HiringService</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">招聘 · 上岗 · 离职</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "d8" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D8</B> Team / Agent</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">花名册 · 状态 · 队列 · 历史</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D1</B> AgentMailbox</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">ready / deferred</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "d2" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BORDER="1" SIDES="T" COLOR="#9a8b3a" WIDTH="14"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3b3a2a"><B>D2</B> ScheduleTable</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">定时提醒</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" COLOR="#9a8b3a"></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "e_client" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E3</B> 客户 / 用户</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">暂停 · 恢复 · 看状态</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_conf" -> "p0" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 角色定义 + 模型端点 "];
  "p0" -> "p0b" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" new Company(...) "];
  "p0" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 注册全部 Agent "];
  "p0" -> "p14" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 注入 ShellRegistry / AgentFactory "];
  "p0" -> "d2" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee"];
  "p3" -> "p11" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" onShiftEnd "];
  "p3" -> "d6" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 写当日总结 "];
  "p11" -> "d3" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" closeDay：压缩 + 归档 "];
  "d8" -> "p13" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" 角色快照 "];
  "d1" -> "p13" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 队列 "];
  "d3" -> "p13" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 对话 "];
  "d2" -> "p13" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 提醒 "];
  "p13" -> "d5" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" save() "];
  "d5" -> "p13" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" load() "];
  "d5" -> "e_disk" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" JSON 文件 "];
  "d6" -> "e_disk" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee"];
  "p14" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" hire / onboard / resign "];
  "p14" -> "d1" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 新角色的队列 "];
  "d8" -> "p14" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", style="dashed", label=" 候选 / 花名册 "];
  "e_client" -> "p0b" [fontname="Source Han Sans CN", fontsize="9", color="#b8526a", fontcolor="#374151", penwidth="1.4", dir="forward", arrowhead="vee", label=" pause(reason) / resume() "];
  "p0b" -> "d8" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 暂停门广播（等待中的角色挂起） "];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">矩形 = 外部实体 E</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">圆角 = 处理 P</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">横线夹字 = 数据存储 D</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">实线 = 主数据流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">虚线 = 查询 / 次要流</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">启动顺序：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P0 造共享件 → P0.1 起线程 →</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P14 复原 / 招聘 → P3 上班。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">恢复语义：state.json 里的</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">队列与历史重新灌回 D1 / D8，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">未完成任务不会丢。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">P0.1 的 pause 不影响正在</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">跑的一轮工具调用，只在</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TaskRunner 取下一个任务时</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">和 onShiftEnd 处生效。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
