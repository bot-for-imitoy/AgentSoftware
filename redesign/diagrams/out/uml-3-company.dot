digraph "uml_company" {
  rankdir="TB";
  nodesep="0.42";
  ranksep="0.8";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "CompanyView" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>CompanyView</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status() : CompanyStatus<BR ALIGN="LEFT"/>+ roster() : List&lt;RoleSpec&gt;<BR ALIGN="LEFT"/>+ pause(String) / + resume()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Company" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3a8794"><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="12"><B>Company</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">company · 唯一的组合根</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- team      : Team             花名册<BR ALIGN="LEFT"/>- clock     : SimClock         模拟时钟<BR ALIGN="LEFT"/>- driver    : ClockDriver      时钟线程<BR ALIGN="LEFT"/>- router    : EventRouter      事件入口<BR ALIGN="LEFT"/>- schedule  : ScheduleTable    定时提醒<BR ALIGN="LEFT"/>- director  : ShiftDirector    班次边界<BR ALIGN="LEFT"/>- gate      : LifecycleGate    暂停门<BR ALIGN="LEFT"/>- staffing  : Staffing         人事<BR ALIGN="LEFT"/>- snapshots : SnapshotStore    存档</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / stop()<BR ALIGN="LEFT"/>+ publish(AgentEvent)        外部事件入口<BR ALIGN="LEFT"/>+ save() / restore()         快照<BR ALIGN="LEFT"/>+ paused() / pauseReason() / pause(String) / resume()<BR ALIGN="LEFT"/>+ clock() / team() / schedule()<BR ALIGN="LEFT"/>+ status() / roster()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "CompanyStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>CompanyStatus</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">clock : DayTick   dateTime / describe<BR ALIGN="LEFT"/>paused / pauseReason<BR ALIGN="LEFT"/>agents : List&lt;AgentSnapshot&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "SnapshotStore" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3a8794"><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="12"><B>SnapshotStore</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ load() : Optional&lt;CompanySnapshot&gt;<BR ALIGN="LEFT"/>+ save(CompanySnapshot)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "JsonSnapshotStore" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3a8794"><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="12"><B>JsonSnapshotStore</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">company.store</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- paths : AppPaths<BR ALIGN="LEFT"/>- json : JsonCodec</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "CompanySnapshot" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>CompanySnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">version / savedAt<BR ALIGN="LEFT"/>clock : DayTick   baseDate : LocalDate<BR ALIGN="LEFT"/>roles : List&lt;RoleSnapshot&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "SimClock" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>SimClock</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ClockDriver" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>ClockDriver</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "EventRouter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>EventRouter</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ScheduleTable" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>ScheduleTable</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ShiftDirector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3a8794"><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="12"><B>ShiftDirector</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "LifecycleGate" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>LifecycleGate</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">◀ 见第 2 张图</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "AgentDirectory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>AgentDirectory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ spec(RoleId) : Optional&lt;RoleSpec&gt;<BR ALIGN="LEFT"/>+ specs() : List&lt;RoleSpec&gt;<BR ALIGN="LEFT"/>+ stateOf(RoleId) : Optional&lt;AgentState&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Team" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Team</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent · 无依赖</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- byId : Map&lt;RoleId, Agent&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(Agent) / + resign(RoleId)<BR ALIGN="LEFT"/>+ agent(RoleId) / + agents()<BR ALIGN="LEFT"/>+ startAll() / stopAll()<BR ALIGN="LEFT"/>+ snapshots() : List&lt;AgentSnapshot&gt;<BR ALIGN="LEFT"/>+ anyBusy() / allIdle() / allOffDuty()   ◀ Sensors</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Agent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Agent</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent（详见第 1 张图）</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">spec / shell / mailbox / state …</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / stop() / submit(Task, boolean)<BR ALIGN="LEFT"/>+ snapshot() : AgentSnapshot</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "AgentSnapshot" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>AgentSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id / name / state / busy<BR ALIGN="LEFT"/>queueDepth / currentTask</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "AgentFactory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>AgentFactory</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">bootstrap 提供 lambda</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(RoleSpec) : Agent</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Staffing" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Staffing</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent · 人事</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- team    : Team<BR ALIGN="LEFT"/>- factory : AgentFactory</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hire(RoleSpec) : Agent<BR ALIGN="LEFT"/>+ onboard(RoleSpec) : Agent<BR ALIGN="LEFT"/>+ resign(RoleId) : boolean<BR ALIGN="LEFT"/>+ restore(List&lt;RoleSnapshot&gt;) : int</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "RoleSpec" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>RoleSpec</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.role · 不可变</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id / name / username / uid / title<BR ALIGN="LEFT"/>responsibilities / personality / skills<BR ALIGN="LEFT"/>group / email / promptExtra<BR ALIGN="LEFT"/>interestKeywords / salienceThreshold<BR ALIGN="LEFT"/>computer : ComputerSpec<BR ALIGN="LEFT"/>toolkits : Set&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Builder<BR ALIGN="LEFT"/>+ hasGroup() : boolean</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "RoleSnapshot" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>RoleSnapshot</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">spec : RoleSpec<BR ALIGN="LEFT"/>state : AgentState<BR ALIGN="LEFT"/>ready / deferred 队列<BR ALIGN="LEFT"/>history / conversation 状态</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "CompanyBuilder" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8557a3"><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#8557a3" POINT-SIZE="12"><B>CompanyBuilder</B></FONT></TD></TR><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">bootstrap</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- config / paths / json<BR ALIGN="LEFT"/>- llmOverride / clientChannel / transcript</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ withLlm(LlmClient)<BR ALIGN="LEFT"/>+ withClientChannel(ClientChannel)<BR ALIGN="LEFT"/>+ withTranscript(Transcript.Feed)<BR ALIGN="LEFT"/>+ build() : Company</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolkitCatalog" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8557a3"><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#8557a3" POINT-SIZE="12"><B>ToolkitCatalog</B></FONT></TD></TR><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">bootstrap</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- factories : Map&lt;String, Function&lt;Deps, Toolkit&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(String, Function&lt;Deps, Toolkit&gt;)<BR ALIGN="LEFT"/>+ build(RoleSpec, Shell, AgentTasks,<BR ALIGN="LEFT"/>        AgentControl) : Toolbox<BR ALIGN="LEFT"/>record Deps(spec, shell, tasks, control)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ShellRegistry" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>ShellRegistry</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- paths : AppPaths<BR ALIGN="LEFT"/>- networkName : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(RoleSpec) : Shell<BR ALIGN="LEFT"/>+ destroy(RoleId) / + all() : List&lt;Shell&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Main" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8557a3"><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#8557a3" POINT-SIZE="12"><B>Main</B></FONT></TD></TR><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">bootstrap</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(String[])</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ChatFeed" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4f8b63"><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#4f8b63" POINT-SIZE="12"><B>ChatFeed</B></FONT></TD></TR><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">transcript · 实现 Feed</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ reasoning / + note / + toolCall / + answer<BR ALIGN="LEFT"/>+ talk(Talk) / + client(Client) / + system(String)<BR ALIGN="LEFT"/>+ since(long) : List&lt;Entry&gt;<BR ALIGN="LEFT"/>+ watermark() : long</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Transcript" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4f8b63"><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#4f8b63" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#4f8b63" POINT-SIZE="12"><B>Transcript</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ reasoning(RoleId, String, TraceMeta)<BR ALIGN="LEFT"/>+ toolCall(RoleId, String, String, String, TraceMeta)<BR ALIGN="LEFT"/>+ answer(RoleId, String, boolean, int, TraceMeta)<BR ALIGN="LEFT"/>+ talk(Talk) / + client(Client) / + system(String)<BR ALIGN="LEFT"/>interface Feed extends Transcript<BR ALIGN="LEFT"/>  + since(long) : List&lt;Entry&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ChatWebServer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4f8b63"><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#4f8b63" POINT-SIZE="12"><B>ChatWebServer</B></FONT></TD></TR><TR><TD BGCOLOR="#eef7f0" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">web · JDK HttpServer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- view : CompanyView<BR ALIGN="LEFT"/>- feed : Transcript.Feed<BR ALIGN="LEFT"/>- host / port</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / stop()<BR ALIGN="LEFT"/>+ port() / host()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Company" -> "CompanyView" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "Company" -> "Team" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "SimClock" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "ClockDriver" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "EventRouter" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "ScheduleTable" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "ShiftDirector" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "LifecycleGate" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "Staffing" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "SnapshotStore" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Company" -> "CompanyStatus" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" status() ", labeldistance="1.4"];
  "JsonSnapshotStore" -> "SnapshotStore" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "SnapshotStore" -> "CompanySnapshot" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "CompanySnapshot" -> "RoleSnapshot" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "Team" -> "AgentDirectory" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "Team" -> "Agent" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="odiamond", label=" * ", labeldistance="1.4"];
  "Team" -> "AgentSnapshot" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" snapshots() ", labeldistance="1.4"];
  "Agent" -> "AgentSnapshot" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" snapshot() ", labeldistance="1.4"];
  "Staffing" -> "Team" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="odiamond"];
  "Staffing" -> "AgentFactory" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 创建 Agent ", labeldistance="1.4"];
  "AgentFactory" -> "Agent" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "AgentFactory" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "RoleSnapshot" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "Team" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" specs() ", labeldistance="1.4"];
  "CompanyBuilder" -> "Company" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" build() ", labeldistance="1.4"];
  "CompanyBuilder" -> "ToolkitCatalog" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 注册所有工具包 ", labeldistance="1.4"];
  "ToolkitCatalog" -> "ShellRegistry" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "ToolkitCatalog" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" 按 spec.toolkits 选包 ", labeldistance="1.4"];
  "Main" -> "CompanyBuilder" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 装配入口 ", labeldistance="1.4"];
  "ChatFeed" -> "Transcript" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" Transcript.Feed ", labeldistance="1.4"];
  "ChatWebServer" -> "Transcript" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "ChatWebServer" -> "CompanyView" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" /api/state ", labeldistance="1.4"];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例 · 颜色 = 包</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">青 = company        绿 = agent</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">紫 = bootstrap      灰 = tool.computer</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">浅绿 = transcript / web</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">蓝 = 接口           黄 = record</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">◆ 组合  ◇ 聚合  ▶ 关联</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">┄▷ 实现  ┄▶ 依赖</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Company 是唯一组合根：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">所有共享件在这里被 new 出来</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
