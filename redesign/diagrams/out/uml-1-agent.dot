digraph "uml_agent" {
  rankdir="LR";
  nodesep="0.35";
  ranksep="1.1";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "AgentTasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>AgentTasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+pending() : List&lt;Task&gt;<BR ALIGN="LEFT"/>+history(int) : List&lt;Task&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "AgentControl" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>AgentControl</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+transitionTo(AgentState)<BR ALIGN="LEFT"/>+closeDayConversation(int)<BR ALIGN="LEFT"/>+powerOffComputer()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Toolbox" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>Toolbox</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+specs() : List&lt;ToolSpec&gt;<BR ALIGN="LEFT"/>+invoke(String, Payload) : ToolResult</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolboxFactory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>ToolboxFactory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(RoleSpec, AgentTasks,<BR ALIGN="LEFT"/>        AgentControl) : Toolbox</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "LlmClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c07a35"><TR><TD BGCOLOR="#fdf1e6" ALIGN="CENTER"><FONT COLOR="#c07a35" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#fdf1e6" ALIGN="CENTER"><FONT COLOR="#c07a35" POINT-SIZE="12"><B>LlmClient</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+chat(ChatRequest) : ChatReply<BR ALIGN="LEFT"/>+chatWithTools(ToolChatRequest) : ToolReply<BR ALIGN="LEFT"/>+summarize(String, double, int) : ChatReply</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Shell" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>Shell</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+powerOn() / +powerOff()<BR ALIGN="LEFT"/>+run(String, Duration, int) : CommandResult<BR ALIGN="LEFT"/>+readFile / +writeFile / +listDir / +deleteFile<BR ALIGN="LEFT"/>+workdir() / +driveRoot() / +hostDir()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "NoteBook" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>NoteBook</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.note</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+write(Note) / +edit(Note) / +read(...)<BR ALIGN="LEFT"/>+saveSummary(RoleId, int, String)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Clock" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>Clock</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+now() : Tick<BR ALIGN="LEFT"/>+nowDay() : DayTick<BR ALIGN="LEFT"/>+calendar() : ShiftCalendar<BR ALIGN="LEFT"/>+currentDateTime() : String</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Agent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Agent</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">每个角色一份</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- spec           : RoleSpec          角色定义（不可变）<BR ALIGN="LEFT"/>- shell          : Shell             个人电脑<BR ALIGN="LEFT"/>- mailbox        : AgentMailbox  ◆   ready / deferred 双队列<BR ALIGN="LEFT"/>- state          : AgentStateMachine ◆ 状态唯一写者<BR ALIGN="LEFT"/>- waits          : WaitCoordinator ◆ talk wait=true 等待协议<BR ALIGN="LEFT"/>- conversation   : ConversationMemory ◆ 当日对话 + 压缩<BR ALIGN="LEFT"/>- toolLoop       : ToolLoop      ◆  LLM ↔ 工具 循环<BR ALIGN="LEFT"/>- prompts        : SystemPrompt  ◆  提示词装配<BR ALIGN="LEFT"/>- toolboxFactory : ToolboxFactory    装配延迟到 start()<BR ALIGN="LEFT"/>- toolbox        : Toolbox      0..1 start() 后才有<BR ALIGN="LEFT"/>- gate           : LifecycleGate ▶  全局暂停门（共享，只读）<BR ALIGN="LEFT"/>- history        : List&lt;Task&gt;        已结束任务<BR ALIGN="LEFT"/>- current        : Task         0..1 执行中<BR ALIGN="LEFT"/>- worker         : Thread       0..1 由 start() 创建</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / stop() / isRunning()<BR ALIGN="LEFT"/>+ submit(Task, boolean) / promoteDeferred()<BR ALIGN="LEFT"/>+ state() / busy() / queueDepth()<BR ALIGN="LEFT"/>+ beginTask(Task) / finishTask(Task) / snapshot()<BR ALIGN="LEFT"/>+ pending() / history(int)<BR ALIGN="LEFT"/>+ transitionTo(AgentState) / closeDayConversation(int) / powerOffComputer()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Mailbox" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>AgentMailbox</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ready    : Deque&lt;Task&gt;<BR ALIGN="LEFT"/>- deferred : Deque&lt;Task&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ push(Task, boolean)<BR ALIGN="LEFT"/>+ peek() : Optional&lt;Task&gt;<BR ALIGN="LEFT"/>+ pop() : Optional&lt;Task&gt;<BR ALIGN="LEFT"/>+ promoteDeferred()<BR ALIGN="LEFT"/>+ readyDepth() / deferredDepth()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "State" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>AgentStateMachine</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- state : AgentState</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ to(AgentState) / toIdle()<BR ALIGN="LEFT"/>+ toOffDuty() / toWaiting()<BR ALIGN="LEFT"/>+ restore(AgentState)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Waits" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>WaitCoordinator</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- waitingFor : RoleId<BR ALIGN="LEFT"/>- reply : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ begin(RoleId)<BR ALIGN="LEFT"/>+ await(Duration)<BR ALIGN="LEFT"/>+ deliver(String)<BR ALIGN="LEFT"/>+ abort(String)<BR ALIGN="LEFT"/>+ end() / waiting() / waitingFor()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Memory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2f8878"><TR><TD BGCOLOR="#e6f6f3" ALIGN="CENTER"><FONT COLOR="#2f8878" POINT-SIZE="12"><B>ConversationMemory</B></FONT></TD></TR><TR><TD BGCOLOR="#e6f6f3" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dialog</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- policy : ConversationPolicy<BR ALIGN="LEFT"/>- messages : List&lt;Message&gt;<BR ALIGN="LEFT"/>- day / closedDay : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prepare(String, String, int) : List&lt;Message&gt;<BR ALIGN="LEFT"/>+ commit(int, String, String, LlmClient)<BR ALIGN="LEFT"/>+ closeDay(int) / + snapshot() / + restore(State)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ConvPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>ConversationPolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maxHistoryChars<BR ALIGN="LEFT"/>maxSummaryChars<BR ALIGN="LEFT"/>toolRecapLimit</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ shouldCompact(long) : boolean<BR ALIGN="LEFT"/>+ keepMessages() : int</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Prompts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2f8878"><TR><TD BGCOLOR="#e6f6f3" ALIGN="CENTER"><FONT COLOR="#2f8878" POINT-SIZE="12"><B>SystemPrompt</B></FONT></TD></TR><TR><TD BGCOLOR="#e6f6f3" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dialog</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- clock : Clock          ◀ sim.clock<BR ALIGN="LEFT"/>- summaries : DailySummary ◀ 本包窄端口<BR ALIGN="LEFT"/>  （实现是 tool.note.JsonNoteBook）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ build(RoleSpec) : String</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "DailySummary" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>DailySummary</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dialog · 只声明要用的那一个方法</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ latestSummary(RoleId, int)<BR ALIGN="LEFT"/>    : Optional&lt;String&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolLoop" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>ToolLoop</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.task</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- llm        : LlmClient<BR ALIGN="LEFT"/>- toolbox    : Toolbox<BR ALIGN="LEFT"/>- transcript : Transcript<BR ALIGN="LEFT"/>- policy     : ToolLoopPolicy</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run(RoleId, String, Task,<BR ALIGN="LEFT"/>      ConversationMemory, int) : Outcome<BR ALIGN="LEFT"/>record Outcome(answer, tokens, failed)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "LoopPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>ToolLoopPolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">maxRounds<BR ALIGN="LEFT"/>maxTotalTokens<BR ALIGN="LEFT"/>failOnLlmError</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ roundBudgetExceeded(int)<BR ALIGN="LEFT"/>+ tokenBudgetExceeded(int)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Runner" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>TaskRunner</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.task · Runnable</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- mailbox : AgentMailbox<BR ALIGN="LEFT"/>- tasks   : AgentTasks<BR ALIGN="LEFT"/>- control : AgentControl<BR ALIGN="LEFT"/>- toolLoop / -transcript / -gate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run()<BR ALIGN="LEFT"/>+ requestStop()<BR ALIGN="LEFT"/>（不认识 agent.Agent）</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Task" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>Task</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.task</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id / urgency / description<BR ALIGN="LEFT"/>source / context / createdAt<BR ALIGN="LEFT"/>assignee  不可变<BR ALIGN="LEFT"/>status / result / tokens  可变</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fromEvent(AgentEvent, RoleId)<BR ALIGN="LEFT"/>+ markRunning() / complete(String,int) / fail(String)<BR ALIGN="LEFT"/>+ toRecord() / fromRecord(TaskRecord)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Gate" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>LifecycleGate</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent · 共享单例</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- paused : boolean<BR ALIGN="LEFT"/>- reason : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pause(String) / resume()<BR ALIGN="LEFT"/>+ paused() / reason()<BR ALIGN="LEFT"/>+ awaitRunning(Duration)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "StateEnum" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«enum»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>AgentState</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">OFF_DUTY · ON_DUTY_IDLE · ON_DUTY_BUSY<BR ALIGN="LEFT"/>WRAPPING_UP · WAITING<BR ALIGN="LEFT"/>+ onDuty() / holdsOrdinaryWork()<BR ALIGN="LEFT"/>+ acceptsEmergency()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "RoleSpec" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>RoleSpec</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.role · 不可变的角色定义</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id / name / username / uid / title<BR ALIGN="LEFT"/>responsibilities / personality / skills<BR ALIGN="LEFT"/>group / email / promptExtra<BR ALIGN="LEFT"/>interestKeywords / salienceThreshold<BR ALIGN="LEFT"/>computer : ComputerSpec<BR ALIGN="LEFT"/>toolkits : Set&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Builder</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Agent" -> "AgentTasks" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "Agent" -> "AgentControl" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "Agent" -> "Mailbox" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "State" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "Waits" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "Memory" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "ToolLoop" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "Prompts" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "Task" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="odiamond", label=" history / current ", labeldistance="1.4"];
  "Agent" -> "Toolbox" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" toolbox 0..1 ", labeldistance="1.4"];
  "Agent" -> "Shell" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" shell 1 ", labeldistance="1.4"];
  "Agent" -> "Gate" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" gate（共享，只读） ", labeldistance="1.4"];
  "Agent" -> "ToolboxFactory" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" start() 时装配 ", labeldistance="1.4"];
  "Agent" -> "Runner" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" new Thread(new TaskRunner) ", labeldistance="1.4"];
  "Memory" -> "ConvPolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "ToolLoop" -> "LoopPolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "State" -> "StateEnum" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "Mailbox" -> "Task" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="odiamond", label=" ready / deferred 存 Task ", labeldistance="1.4"];
  "Agent" -> "RoleSpec" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" spec 1（不可变） ", labeldistance="1.4"];
  "ToolLoop" -> "LlmClient" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "ToolLoop" -> "Toolbox" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "ToolLoop" -> "Task" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 入参 ", labeldistance="1.4"];
  "ToolLoop" -> "Memory" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" 作为入参传入 ", labeldistance="1.4"];
  "Runner" -> "ToolLoop" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "Runner" -> "Gate" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "Runner" -> "Task" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 从队列取 ", labeldistance="1.4"];
  "Waits" -> "Task" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 代理出去的任务 ", labeldistance="1.4"];
  "Prompts" -> "Clock" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" 读当前时间 ", labeldistance="1.4"];
  "Prompts" -> "DailySummary" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond", label=" 读昨天 ", labeldistance="1.4"];
  "NoteBook" -> "DailySummary" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" tool.note.JsonNoteBook 实现 ", labeldistance="1.4"];
  "Prompts" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" build(spec) ", labeldistance="1.4"];
  "Memory" -> "LlmClient" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" 压缩时 summarize ", labeldistance="1.4"];
  "ToolboxFactory" -> "RoleSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" 按 spec.toolkits 装配 ", labeldistance="1.4"];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例 · 颜色 = 包</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">绿 = agent        靛 = agent.task</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">青 = agent.dialog   黄 = 值对象 / record</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">蓝 = tool.spi、跨包接口</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">灰 = tool.*        橙 = llm</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">（NoteBook 在 tool.note，仅作对照）</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">紫 = sim.clock</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">◆ 组合   ◇ 聚合   ▶ 关联</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">┄▷ 实现   ┄▶ 依赖</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
