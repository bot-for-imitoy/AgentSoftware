digraph "dfd_0_context" {
  rankdir="LR";
  nodesep="0.5";
  ranksep="1.5";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "sys" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e9f2fd" STYLE="rounded" COLOR="#3a72b0"><TR><TD ROWSPAN="1" BGCOLOR="#3a72b0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>0</B></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37">软件公司模拟器</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#5a6472">多角色 LLM Agent · 模拟班次 08:00–18:00</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e9f2fd", color="#3a72b0", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_client" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E1</B> 客户 / 用户</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">Web GUI · 控制台</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_llm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E2</B> LLM 服务</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">OpenAI 兼容端点</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_smtp" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E3</B> SMTP 服务</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">外发邮件</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_pc" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E4</B> 个人电脑</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">podman 容器 / 本地 / SSH</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_conf" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E5</B> 角色与配置</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">role_templates.json · providers.json</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_disk" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#e6e7ec" COLOR="#454c57"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#1f2a37"><B>E6</B> 磁盘存档</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#6b7280">state.json · 笔记 / 待办 / 技能 / 邮箱</FONT></TD></TR></TABLE>>, shape="box", style="filled", fillcolor="#e6e7ec", color="#454c57", penwidth="1.2", fontname="Source Han Sans CN", fontsize="11", margin="0"];
  "e_client" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 提问 / 回复 / 暂停·恢复 "];
  "sys" -> "e_client" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 聊天流 · 公司状态 · 轨迹 "];
  "sys" -> "e_llm" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" system + 消息 + 工具声明 "];
  "e_llm" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 文本 / tool_calls / tokens "];
  "sys" -> "e_smtp" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 外发邮件 "];
  "e_smtp" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 新邮件通知 "];
  "sys" -> "e_pc" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 命令 / 写文件 "];
  "e_pc" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" stdout / 文件内容 "];
  "e_conf" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 角色定义 · 模型端点 · MCP 规则 "];
  "sys" -> "e_disk" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 快照 / 总结 / 笔记 "];
  "e_disk" -> "sys" [fontname="Source Han Sans CN", fontsize="9", color="#4b5563", fontcolor="#374151", penwidth="1.2", dir="forward", arrowhead="vee", label=" 上次的队列 / 历史 / 对话 "];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>说明</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">整个模拟器是 1 个处理：Company。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">它只在 6 条边界上与外界交换数据；</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">内部的 14 个子处理见 Level-1。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E1 通过 web.ChatWebServer 进出</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E2 通过 llm.OpenAiClient</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E3 通过 tool.mail.SmtpSender</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E4 通过 tool.computer.Shell 三实现</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E5 通过 infra.config.ConfigLoader</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">E6 通过 company.store.JsonSnapshotStore</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
