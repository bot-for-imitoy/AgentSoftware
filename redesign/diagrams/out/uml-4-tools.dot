digraph "uml_tools" {
  rankdir="LR";
  nodesep="0.35";
  ranksep="0.95";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "Toolkit" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>Toolkit</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.spi · 插件 SPI</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id() : String<BR ALIGN="LEFT"/>+ instantiate() : List&lt;Tool&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Tool" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>Tool</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.spi</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ spec() : ToolSpec<BR ALIGN="LEFT"/>+ invoke(RoleId, Payload) : ToolResult</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Toolbox" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>Toolbox</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.spi</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ specs() : List&lt;ToolSpec&gt;<BR ALIGN="LEFT"/>+ invoke(String, Payload) : ToolResult</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolSpec" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>ToolSpec</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">name / description<BR ALIGN="LEFT"/>schema : JsonSchema</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolResult" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>ToolResult</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">text / error</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ok(String) / + error(String)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolboxFactory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>ToolboxFactory</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(RoleSpec, AgentTasks,<BR ALIGN="LEFT"/>        AgentControl) : Toolbox</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ToolkitCatalog" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8557a3"><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#8557a3" POINT-SIZE="12"><B>ToolkitCatalog</B></FONT></TD></TR><TR><TD BGCOLOR="#f6eefa" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">bootstrap · 唯一知道全部具体工具包的地方</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- factories : Map&lt;String, Function&lt;Deps, Toolkit&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(String, Function&lt;Deps, Toolkit&gt;)<BR ALIGN="LEFT"/>+ build(RoleSpec, Shell, AgentTasks,<BR ALIGN="LEFT"/>        AgentControl) : Toolbox<BR ALIGN="LEFT"/>record Deps(spec, shell, tasks, control)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Agent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Agent</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- toolkits : Set&lt;String&gt;   来自 RoleSpec<BR ALIGN="LEFT"/>- toolbox : Toolbox  0..1</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start()   此刻才装配<BR ALIGN="LEFT"/>+ submit / + promoteDeferred</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "RoleSpec" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>RoleSpec</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.role</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">toolkits : Set&lt;String&gt;<BR ALIGN="LEFT"/>computer : ComputerSpec</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ShellRegistry" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>ShellRegistry</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- paths / - networkName</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(RoleSpec) : Shell</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "catalog" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD COLSPAN="5" BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT POINT-SIZE="12" COLOR="#5f6875"><B>tool.* —— 13 个工具包（一个包一个能力，各自 implements Toolkit）</B></FONT></TD></TR><TR><TD BGCOLOR="#5f6875"><FONT COLOR="white" POINT-SIZE="9"><B>包</B></FONT></TD><TD BGCOLOR="#5f6875"><FONT COLOR="white" POINT-SIZE="9"><B>Toolkit 实现</B></FONT></TD><TD BGCOLOR="#5f6875"><FONT COLOR="white" POINT-SIZE="9"><B>构造入参（决定它能碰什么）</B></FONT></TD><TD BGCOLOR="#5f6875"><FONT COLOR="white" POINT-SIZE="9"><B>被注入的实现</B></FONT></TD><TD BGCOLOR="#5f6875"><FONT COLOR="white" POINT-SIZE="9"><B>能力</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.computer</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">PcToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Shell</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Shell</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">电脑：命令 / 文件 / 目录</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.computer</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">HermesToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Shell</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Shell</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">电脑工具的另一套外壳</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.note</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">NoteToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">NoteBook, ReminderScheduler</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">JsonNoteBook 等</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">笔记 + 定时提醒</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.note</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">MemoryToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">NoteBook, Clock, AgentControl</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">JsonNoteBook / SimClock</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">日记 / 总结 / 关机</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.todo</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TodoToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TodoList</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">JsonTodoList</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">待办清单</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.skill</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">SkillToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">SkillLibrary</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">JsonSkillLibrary</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">技能库</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.mail</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">EmailToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Mailbox, AgentDirectory</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">FileMailbox</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">公司邮箱</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.talk</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TalkToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TeamChannel, AgentDirectory, Transcript</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TalkService</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">同事对话（可同步等回复）</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.client</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">ClientToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">ClientChannel, Transcript</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Web / Console 两实现</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">向客户提问</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.hr</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">HrToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Recruiter</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">HiringService</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">招聘 / 生成岗位</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.time</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TimeToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Clock</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">SimClock</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">读时钟</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.task</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">TaskViewToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">AgentTasks</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Agent 自身</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">看自己的任务队列</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.mcp</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">McpToolkit</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">McpBridge</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">StdioMcpBridge</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">外部 MCP 工具</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Shell" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>Shell</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ powerOn() / + powerOff() / + poweredOn()<BR ALIGN="LEFT"/>+ run(String, Duration, int) : CommandResult<BR ALIGN="LEFT"/>+ readFile / + writeFile / + listDir / + deleteFile<BR ALIGN="LEFT"/>+ workdir() / driveRoot() / hostDir() / describe()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "sh_local" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>LocalShell</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ctor(RoleId, ComputerSpec, …)<BR ALIGN="LEFT"/>本地目录</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "sh_podman" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>PodmanShell</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ctor(RoleId, ComputerSpec, …)<BR ALIGN="LEFT"/>podman 容器</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "sh_ssh" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6875"><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#5f6875" POINT-SIZE="12"><B>SshShell</B></FONT></TD></TR><TR><TD BGCOLOR="#eff0f4" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">tool.computer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ctor(RoleId, ComputerSpec, …)<BR ALIGN="LEFT"/>远程主机</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Toolkit" -> "Tool" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" instantiate() 产出一批 Tool ", labeldistance="1.4"];
  "Tool" -> "ToolSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "Tool" -> "ToolResult" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "Toolbox" -> "ToolSpec" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "Toolbox" -> "ToolResult" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "sh_local" -> "Shell" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "sh_podman" -> "Shell" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "sh_ssh" -> "Shell" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "catalog" -> "Toolkit" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="invis", label=" 每一行都是它的实现 ", labeldistance="1.4"];
  "ToolkitCatalog" -> "Toolkit" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 注册 13 个工厂 lambda ", labeldistance="1.4"];
  "ToolkitCatalog" -> "Shell" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 构造期注入 ", labeldistance="1.4"];
  "ToolkitCatalog" -> "RoleSpec" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 按 spec.toolkits 过滤 ", labeldistance="1.4"];
  "Agent" -> "ToolboxFactory" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" lambda: catalog::build ", labeldistance="1.4"];
  "Agent" -> "RoleSpec" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "Agent" -> "Shell" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 1 ", labeldistance="1.4"];
  "Agent" -> "ToolkitCatalog" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" start() 时回调 ", labeldistance="1.4"];
  "ShellRegistry" -> "Shell" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 按 ComputerSpec 造一个 ", labeldistance="1.4"];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>装配顺序（为什么可以没有环）</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">1. ConfigLoader 读 role_templates.json</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">   → RoleSpec（含 toolkits 名单）</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">2. CompanyBuilder 造共享件：SimClock /</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">   Team / ShellRegistry / ScheduleTable …</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">3. Team.register(Agent)：Agent 拿到 spec +</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">   shell + AgentTasks / AgentControl 三个接口</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">4. Agent.start() → ToolboxFactory.create(...)</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">   → ToolkitCatalog.build(spec, shell, this, this)</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">5. catalog 按 spec.toolkits 逐个 new Toolkit，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">   再 collect 它们的 Tool 拼成 Toolbox</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">结果：agent 包不认识任何具体工具包；</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">tool.* 只认识 agent 的接口定义。</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">■ 唯一反向边：ShellRegistry 需要</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  RoleSpec.ComputerSpec（电脑规格写在角色</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  定义里），已记在 PLAN §5.9-B.8</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
