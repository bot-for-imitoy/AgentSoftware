digraph "arch_states" {
  rankdir="LR";
  nodesep="0.5";
  ranksep="1.1";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "off" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#e8f4ea" COLOR="#3f8b4c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>OFF_DUTY</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">下班：电脑已关机</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e8f4ea", color="#3f8b4c", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "idle" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#e8f4ea" COLOR="#3f8b4c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>ON_DUTY_IDLE</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">在岗待命：可以接普通任务</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e8f4ea", color="#3f8b4c", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "busy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#e8f4ea" COLOR="#3f8b4c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>ON_DUTY_BUSY</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">执行中：持有一个 Task</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e8f4ea", color="#3f8b4c", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "waiting" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#e8f4ea" COLOR="#3f8b4c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>WAITING</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">等同事回话：talk wait=true</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#e8f4ea", color="#3f8b4c", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "wrap" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fdf6e7" COLOR="#b8862c"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>WRAPPING_UP</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">收尾：写总结 / 关对话</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#fdf6e7", color="#b8862c", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "emerg" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fdeef0" COLOR="#b8526a"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13"><B>acceptsEmergency()</B></FONT><BR ALIGN="CENTER"/><FONT POINT-SIZE="9" COLOR="#5a6472">紧急事件在 WAITING / WRAPPING_UP 仍可投递</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", fillcolor="#fdeef0", color="#b8526a", penwidth="1.6", fontname="Source Han Sans CN", margin="0"];
  "off" -> "idle" [dir="forward", arrowhead="vee", color="#3f74b5", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" ShiftDirector.onShiftStart
powerOn + promoteDeferred ", style="solid"];
  "idle" -> "busy" [dir="forward", arrowhead="vee", color="#3f74b5", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" TaskRunner 取到任务
Agent.beginTask ", style="solid"];
  "busy" -> "idle" [dir="forward", arrowhead="vee", color="#4f8b63", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" Agent.finishTask
（成功 / 失败 / 超限都算） ", style="solid"];
  "busy" -> "waiting" [dir="forward", arrowhead="vee", color="#3f74b5", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" TalkToolkit 调用
WaitCoordinator.begin(B) ", style="solid"];
  "waiting" -> "busy" [dir="forward", arrowhead="vee", color="#4f8b63", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" deliver(reply) / abort(合成回复) ", style="solid"];
  "idle" -> "wrap" [dir="forward", arrowhead="vee", color="#b8862c", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" ShiftDirector.onShiftEnd ", style="solid"];
  "busy" -> "wrap" [dir="forward", arrowhead="vee", color="#b8862c", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" onShiftEnd（跑完手头这轮工具调用） ", style="solid"];
  "waiting" -> "wrap" [dir="forward", arrowhead="vee", color="#b8862c", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" onShiftEnd → abort 解阻塞 ", style="solid"];
  "wrap" -> "off" [dir="forward", arrowhead="vee", color="#6b7280", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" closeDayConversation
+ powerOffComputer ", style="solid"];
  "busy" -> "off" [dir="forward", arrowhead="vee", color="#b8526a", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" forceWrapUp（超时兜底） ", style="dashed", constraint="false"];
  "idle" -> "off" [dir="forward", arrowhead="vee", color="#b8526a", penwidth="1.6", fontname="Source Han Sans CN", fontsize="10", fontcolor="#374151", label=" forceWrapUp（超时兜底） ", style="dashed", constraint="false"];
  "emerg" -> "waiting" [dir="none", style="dotted", color="#b8526a", penwidth="1.4", constraint="false"];
  "emerg" -> "wrap" [dir="none", style="dotted", color="#b8526a", penwidth="1.4", constraint="false"];
  "gate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#3a8794"><B>LifecycleGate（Company.pause/reason）</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">暂停不是状态机的第 6 个状态，而是</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">一个独立的只读闸门：</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">· TaskRunner 每轮开头 awaitRunning()</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  → 没取到任务时原地等，不进 BUSY</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">· ClockDriver 同时被 pause()，</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  模拟时间停住，不会跑到下班</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">· 已经在跑的一轮工具调用不打断</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">所以“暂停中”= gate.paused() 为真，</FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Agent 仍处在各自的正常状态里。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "who" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>谁改状态（唯一写者）</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">AgentStateMachine.to(next) 是唯一入口；</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">调用它的只有三处：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  · Agent.beginTask / finishTask</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  · Agent.transitionTo（AgentControl 接口）</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">  · Agent.restore（从快照恢复）</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">ShiftDirector 不直接写状态，它通过</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">AgentControl 让 Agent 自己迁移 —— 这就是</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">把 920 行的 TimeEventBus 拆开的收益：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">班次逻辑不再认识状态机的内部字段。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
