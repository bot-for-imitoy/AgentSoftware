digraph "uml_sim" {
  rankdir="TB";
  nodesep="0.42";
  ranksep="0.8";
  splines="spline";
  bgcolor="white";
  pad="0.3";
  compound="true";
  fontname="Source Han Sans CN";
  fontsize="11";
  newrank="true";
  node [shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  edge [fontname="Source Han Sans CN", fontsize="9", color="#5b6472", penwidth="1.1"];
  "Clock" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>Clock</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ now() : Tick<BR ALIGN="LEFT"/>+ nowDay() : DayTick<BR ALIGN="LEFT"/>+ calendar() : ShiftCalendar<BR ALIGN="LEFT"/>+ currentDateTime() : String<BR ALIGN="LEFT"/>+ describe() : String</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "SimClock" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>SimClock</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">sim.clock</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- calendar : ShiftCalendar<BR ALIGN="LEFT"/>- baseDate : LocalDate<BR ALIGN="LEFT"/>- tick     : long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ advanceTicks(long) / + jumpTo(Tick)<BR ALIGN="LEFT"/>+ resetTo(DayTick) / + setBaseDate(LocalDate)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ShiftCalendar" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>ShiftCalendar</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">sim.clock</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">secondsPerTick / shiftStartHour / shiftEndHour</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ locate(Tick) / at(int,int) : DayTick<BR ALIGN="LEFT"/>+ withinShift(DayTick)<BR ALIGN="LEFT"/>+ ticksUntilShiftEnd(DayTick)<BR ALIGN="LEFT"/>+ nextShiftStart(DayTick)<BR ALIGN="LEFT"/>+ clockTime(DayTick) / describe(Tick)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Tick" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>Tick</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">已下放到 kernel</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">value : long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ plus(long) / before(Tick) / after(Tick)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "DayTick" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>DayTick</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">已下放到 kernel</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">day / tickOfDay : int</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ClockDriver" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>ClockDriver</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">sim.clock</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- clock    : SimClock<BR ALIGN="LEFT"/>- schedule : ScheduleTable<BR ALIGN="LEFT"/>- policy   : ClockPolicy<BR ALIGN="LEFT"/>- sink     : EventSink<BR ALIGN="LEFT"/>- sensors  : Sensors<BR ALIGN="LEFT"/>- observer : TickObserver<BR ALIGN="LEFT"/>- options  : ClockOptions</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start() / stop()<BR ALIGN="LEFT"/>+ pause() / resume() / paused()<BR ALIGN="LEFT"/>+ tickOnce()<BR ALIGN="LEFT"/>+ nextFireTick() : Optional&lt;Tick&gt;<BR ALIGN="LEFT"/>record ClockOptions(busyPoll, idlePoll, wrapUpGrace)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ClockPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>ClockPolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ next(ClockSignals, ShiftCalendar,<BR ALIGN="LEFT"/>       Tick, Optional&lt;Tick&gt;) : ClockAction<BR ALIGN="LEFT"/>record ClockSignals(anyBusy, allIdle, allOffDuty,<BR ALIGN="LEFT"/>                     wrapUpOverdue, idleMillis)<BR ALIGN="LEFT"/>sealed ClockAction = Advance | FastForwardTo<BR ALIGN="LEFT"/>                   | Hold | ForceWrapUp</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "DefaultClockPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>DefaultClockPolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fastForwardIdleMillis : long</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ScheduleTable" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>ScheduleTable</B></FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">sim.clock</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entries : Map&lt;ScheduleId, ScheduledEntry&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ schedule(String, RoleId, DayTick, Payload)<BR ALIGN="LEFT"/>+ cancel(ScheduleId) / + reschedule(...)<BR ALIGN="LEFT"/>+ list(RoleId) : List&lt;ScheduledEntry&gt;<BR ALIGN="LEFT"/>+ due(Tick) : List&lt;AgentEvent&gt;<BR ALIGN="LEFT"/>+ nextFireTick(Tick) / + activateDay(int)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ReminderScheduler" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f74b5"><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eaf2fd" ALIGN="CENTER"><FONT COLOR="#3f74b5" POINT-SIZE="12"><B>ReminderScheduler</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ schedule(String, RoleId, DayTick, Payload)<BR ALIGN="LEFT"/>+ cancel(ScheduleId)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Sensors" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>Sensors</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ anyBusy() / + allIdle() / + allOffDuty()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "TickObserver" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7551b0"><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#f3edfb" ALIGN="CENTER"><FONT COLOR="#7551b0" POINT-SIZE="12"><B>TickObserver</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ onTick(Tick now)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "EventSink" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8526a"><TR><TD BGCOLOR="#fdeef0" ALIGN="CENTER"><FONT COLOR="#b8526a" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#fdeef0" ALIGN="CENTER"><FONT COLOR="#b8526a" POINT-SIZE="12"><B>EventSink</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ publish(AgentEvent)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Team" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3f8b4c"><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#3f8b4c" POINT-SIZE="12"><B>Team</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f4ea" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent · 花名册</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- byId : Map&lt;RoleId, Agent&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ anyBusy() / + allIdle() / + allOffDuty()<BR ALIGN="LEFT"/>（详见公司编排图）</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "ShiftDirector" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3a8794"><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#3a8794" POINT-SIZE="12"><B>ShiftDirector</B></FONT></TD></TR><TR><TD BGCOLOR="#e8f6f8" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">company</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- team  : Team<BR ALIGN="LEFT"/>- clock : Clock<BR ALIGN="LEFT"/>- gate  : LifecycleGate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ onTick(Tick)<BR ALIGN="LEFT"/>+ onShiftStart() / + onShiftEnd()<BR ALIGN="LEFT"/>+ forceWrapUp()</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "EventRouter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>EventRouter</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dispatch</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- team / -delivery / -tasks / -transcript</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ publish(AgentEvent)<BR ALIGN="LEFT"/>+ publishAndReport(AgentEvent)<BR ALIGN="LEFT"/>    : Map&lt;RoleId, Routed&gt;</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "AgentEvent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>AgentEvent</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">sim.event</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : EventId        kind : EventKind<BR ALIGN="LEFT"/>priority : Priority<BR ALIGN="LEFT"/>recipients : Set&lt;RoleId&gt;   空 = 广播<BR ALIGN="LEFT"/>payload : Payload<BR ALIGN="LEFT"/>fireAt : Optional&lt;Tick&gt;  定时事件<BR ALIGN="LEFT"/>occurredAt : Instant</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ broadcast(...) / toRole(...) / scheduled(...)<BR ALIGN="LEFT"/>+ targeted() / broadcast() / rescheduledTo(Tick)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "EventKind" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«record»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>EventKind</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">source / name</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SHIFT_START · SHIFT_END<BR ALIGN="LEFT"/>TASK_DUE · NEW_MAIL</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "Priority" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8862c"><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="8">«enum»</FONT></TD></TR><TR><TD BGCOLOR="#fdf6e7" ALIGN="CENTER"><FONT COLOR="#b8862c" POINT-SIZE="12"><B>Priority</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">LOW · NORMAL · HIGH · EMERGENCY<BR ALIGN="LEFT"/>+ weight() / ofWeight(int)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "DeliveryPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>DeliveryPolicy</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dispatch</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ decide(DeliveryContext) : DeliveryDecision<BR ALIGN="LEFT"/>record DeliveryContext(event, spec, state,<BR ALIGN="LEFT"/>                        scheduledReminder)<BR ALIGN="LEFT"/>enum DeliveryVerdict = DELIVER|HOLD|DROP<BR ALIGN="LEFT"/>record DeliveryDecision(verdict, reason)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "DefaultDeliveryPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>DefaultDeliveryPolicy</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dispatch</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- salience : SaliencePolicy</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "SaliencePolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#4b55b0"><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="8">«interface»</FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#4b55b0" POINT-SIZE="12"><B>SaliencePolicy</B></FONT></TD></TR><TR><TD BGCOLOR="#eceffc" ALIGN="CENTER"><FONT COLOR="#6b7280" POINT-SIZE="8">agent.dispatch</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ score(RoleSpec, AgentEvent)<BR ALIGN="LEFT"/>    : SalienceDecision(pass, score, relevance, reason)</TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "KeywordSaliencePolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#b8526a"><TR><TD BGCOLOR="#fdeef0" ALIGN="CENTER"><FONT COLOR="#b8526a" POINT-SIZE="12"><B>KeywordSaliencePolicy</B></FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
  "SimClock" -> "Clock" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "SimClock" -> "ShiftCalendar" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 1 ", labeldistance="1.4"];
  "Clock" -> "Tick" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "Clock" -> "DayTick" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "ClockDriver" -> "SimClock" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 1 ", labeldistance="1.4"];
  "ClockDriver" -> "ScheduleTable" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="odiamond"];
  "ClockDriver" -> "ClockPolicy" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 策略 ", labeldistance="1.4"];
  "ClockDriver" -> "EventSink" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 到期事件出口 ", labeldistance="1.4"];
  "ClockDriver" -> "Sensors" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 读忙闲 ", labeldistance="1.4"];
  "ClockDriver" -> "TickObserver" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 班次边界 ", labeldistance="1.4"];
  "DefaultClockPolicy" -> "ClockPolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "ScheduleTable" -> "ReminderScheduler" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "ClockPolicy" -> "Tick" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "ScheduleTable" -> "AgentEvent" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" due() 产出事件 ", labeldistance="1.4"];
  "Team" -> "Sensors" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" 跨包实现（唯一） ", labeldistance="1.4"];
  "ShiftDirector" -> "TickObserver" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" 跨包实现（唯一） ", labeldistance="1.4"];
  "EventRouter" -> "EventSink" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed", label=" 跨包实现（唯一） ", labeldistance="1.4"];
  "EventRouter" -> "AgentEvent" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563"];
  "EventRouter" -> "DeliveryPolicy" [dir="forward", arrowhead="vee", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", label=" 逐收件人裁决 ", labeldistance="1.4"];
  "DefaultDeliveryPolicy" -> "DeliveryPolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "DefaultDeliveryPolicy" -> "SaliencePolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "KeywordSaliencePolicy" -> "SaliencePolicy" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="onormal", style="dashed"];
  "DeliveryPolicy" -> "AgentEvent" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed", label=" DeliveryContext.event ", labeldistance="1.4"];
  "SaliencePolicy" -> "AgentEvent" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="open", style="dashed"];
  "AgentEvent" -> "EventKind" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "AgentEvent" -> "Priority" [dir="both", arrowhead="none", penwidth="1.1", color="#5b6472", fontname="Source Han Sans CN", fontsize="9", fontcolor="#4b5563", arrowtail="diamond"];
  "legend" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#8a929c"><B>图例 · 颜色 = 包</B></FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">紫 = sim.clock      玫 = sim.event</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">绿 = agent（实现 sim 的洞）</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">青 = company        靛 = agent.dispatch</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">黄 = record / enum</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">◆ 组合  ◇ 聚合  ▶ 关联</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">┄▷ 实现  ┄▶ 依赖</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">sim ⇢ agent 的边全部消失：</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">sim 只认识 5 个接口，不认识 Agent；</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">投递策略已移到 agent.dispatch，</FONT></TD></TR><TR><TD BGCOLOR="#f4f5f7" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">Tick / DayTick 已下放到 kernel。</FONT></TD></TR></TABLE>>, shape="plaintext", fontname="Source Han Sans CN", fontsize="11"];
}
